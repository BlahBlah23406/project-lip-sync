# Translation backend. Any OpenAI/Ollama-compatible endpoint works; this is the
# path the pipeline uses by default.
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com/api
LLM_MODEL_NAME=gemma3:27b

# Alternative backend. Used instead of the above when LLM_API_KEY is unset.
# ANTHROPIC_API_KEY=

# TTS is Microsoft Edge TTS — no key, no account.

# Optional tuning; the defaults in code are fine for a normal run.
# TTS_TIMEOUT=45         # seconds before a single TTS attempt is abandoned
# TTS_MAX_RETRIES=6
# TTS_PACING=0           # seconds between TTS calls, if the endpoint throttles
# STALL_TIMEOUT=1200     # seconds without progress before the watchdog dumps stacks
