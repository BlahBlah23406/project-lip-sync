# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model to use — claude-haiku-4-5 is the lowest cost option
# Other options: claude-sonnet-4-6, claude-opus-4-7
ANTHROPIC_MODEL=claude-haiku-4-5

# ElevenLabs API key — get one at https://elevenlabs.io/
# Required for the dubbing pipeline (voice cloning + Bangla TTS)
ELEVENLABS_API_KEY=...
