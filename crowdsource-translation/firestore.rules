rules_version = '2';

// Access model
// ------------
// Two kinds of caller reach this database:
//
//   * Contributors — mobile, signed in anonymously. They read the sentence
//     pool, submit their own translations, and revise their own past work.
//   * Admins — the web console, signed in with email/password AND carrying the
//     `admin: true` custom claim. Only they manage the sentence pool and read
//     the whole translation corpus for export.
//
// The daily allowance is enforced here as well as in the client. The client
// transaction in FirestoreService is a UX affordance; without the rule below a
// contributor could simply write count back to 0 and submit without limit.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    // The fields a contributor is allowed to touch when attaching a translation
    // to a sentence. Anything else (notably `text`) is admin-only.
    function onlyTranslationFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['translations', 'translationCount', 'audioUrl', 'transcription']);
    }

    match /sentences/{sentenceId} {
      // Contributors need the pool to work through.
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Admins may edit anything; contributors only append their translation.
      allow update: if isAdmin() || (signedIn() && onlyTranslationFieldsChanged());
    }

    match /translations/{translationId} {
      // A contributor sees only their own submissions; admins export everything.
      // Draft retries check a known id before creating it. Missing documents
      // contain no contributor data; listing still requires the owner filter.
      allow get: if isAdmin() || (signedIn() &&
          (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('reviewStatus', 'pending') == 'pending'
                    && request.resource.data.get('reviewNote', '') == ''
                    && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']);
      // Redo: the owner may revise, but may never reassign the row to someone else.
      allow update: if (isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedAt'])
                    && resource.data.get('reviewStatus', 'pending') == 'pending'
                    && request.resource.data.reviewStatus in ['approved', 'changesRequested']
                    && request.resource.data.reviewedBy == request.auth.uid
                    && request.resource.data.reviewedAt == request.time
                    && (request.resource.data.reviewStatus == 'approved' || request.resource.data.reviewNote.size() > 0))
                  || (signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'transcription', 'audioUrl', 'inputMethod', 'note', 'updatedAt',
                      'revision', 'reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedAt'])
                    && request.resource.data.revision == resource.data.revision + 1
                    && request.resource.data.reviewStatus == 'pending'
                    && request.resource.data.reviewNote == ''
                    && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']));
      allow delete: if isAdmin();
    }

    match /users/{userId}/dailyQuota/{dayKey} {
      allow read: if isAdmin() || (signedIn() && userId == request.auth.uid);
      // First submission of the day: the counter must start at exactly 1.
      allow create: if signedIn()
                    && userId == request.auth.uid
                    && request.resource.data.count == 1;
      // Every later submission moves the counter up by exactly one, and never
      // past the daily allowance. Monotonic by construction, so the count
      // cannot be reset to buy more submissions.
      allow update: if signedIn()
                    && userId == request.auth.uid
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= 10;
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied.
  }
}
