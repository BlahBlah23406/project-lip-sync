rules_version = '2';

// Each contributor uploads only their own bounded WAV recordings. Download
// URLs are stored with the translation for the contributor and admin export.
service firebase.storage {
  match /b/{bucket}/o {
    match /translations/{userId}/{sentenceId}/{recordingFile} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if owner() ||
          (request.auth != null && 'admin' in request.auth.token
              && request.auth.token.admin == true);
      allow create, update: if owner()
          && recordingFile.matches('.*[.]wav')
          && request.resource.size > 44
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType == 'audio/wav';
    }
  }
}
